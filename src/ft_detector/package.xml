<?xml version="1.0"?>
<package format="2">
  <name>ft_detector</name>
  <version>0.1.0</version>
  <description>Image input and armor detection for the vision final test.</description>
  <maintainer email="268838183+Wit-1@users.noreply.github.com">Wit</maintainer>
