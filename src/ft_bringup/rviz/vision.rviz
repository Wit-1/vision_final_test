Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Frame Timeout: 1.0
      Marker Scale: 1.5
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: true
  Global Options:
    Background Color: 32; 32; 32
    Frame Rate: 30
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Name: Current View
      Pitch: 0.35
      Target Frame: <Fixed Frame>
      Yaw: 1.57
Window Geometry:
  Width: 1100
  Height: 760
