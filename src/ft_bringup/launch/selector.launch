<launch>
  <arg name="camera_info_topic" default="" />
  <node pkg="ft_selector" type="ft_selector_node" name="ft_selector" output="screen" required="true">
    <rosparam command="load" file="$(find ft_bringup)/config/selector.yaml" />
    <!-- Use the same prediction horizon as the baseline tracker. -->
    <rosparam command="load" file="$(find ft_bringup)/config/tracker.yaml" ns="linear" />
    <!-- Empty uses the same-side detector's dataset-resolved camera input. -->
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
  </node>
</launch>
