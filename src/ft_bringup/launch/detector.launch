<launch>
  <arg name="dataset" default="blue_1" />
  <arg name="mode" default="tradition" />

  <node pkg="ft_detector" type="ft_detector_node" name="ft_detector" output="screen" required="true">
    <rosparam command="load" file="$(find ft_bringup)/config/detector.yaml" />
    <rosparam command="load" file="$(find ft_bringup)/config/model.yaml" subst_value="true" />
    <rosparam command="load" file="$(find ft_bringup)/config/datasets/$(arg dataset).yaml" />
    <param name="mode" value="$(arg mode)" />
  </node>
</launch>
