<launch>
  <arg name="dataset" default="blue_1" />
  <arg name="mode" default="tradition" />
  <arg name="gui" default="true" />
  <arg name="rviz" default="false" />
  <arg name="reconfigure" default="false" />
  <arg name="tracker" default="true" />
  <arg name="selector" default="true" />
  <arg name="use_sim_time" default="true" />

  <param name="/use_sim_time" value="$(arg use_sim_time)" />

  <include file="$(find ft_bringup)/launch/detector.launch">
    <arg name="dataset" value="$(arg dataset)" />
    <arg name="mode" value="$(arg mode)" />
  </include>

  <include if="$(arg tracker)" file="$(find ft_bringup)/launch/tracker.launch" />
  <include if="$(arg selector)" file="$(find ft_bringup)/launch/selector.launch" />
  <include if="$(arg selector)" file="$(find ft_bringup)/launch/prediction_overlay.launch" />

  <include file="$(find ft_bringup)/launch/visualization.launch">
    <arg name="gui" value="$(arg gui)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="reconfigure" value="$(arg reconfigure)" />
  </include>
</launch>
