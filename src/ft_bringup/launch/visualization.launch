<launch>
  <arg name="gui" default="true" />
  <arg name="rviz" default="false" />
  <arg name="rviz_fixed_frame" default="camera_optical_frame" />
  <node if="$(arg gui)" pkg="ft_bringup" type="view_debug_image.sh" name="ft_image_view" output="screen" />
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="ft_rviz" output="screen"
        args="-d $(find ft_bringup)/rviz/vision.rviz -f $(arg rviz_fixed_frame)" />
</launch>
