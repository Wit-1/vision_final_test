#!/usr/bin/env python3
"""Read this workspace's ROS packages and generated interfaces without a master."""

import json
from pathlib import Path
import sys

from ft_detection.msg import Detection, DetectionFrame
from ft_msgs.msg import Track, Target
import roslib.packages
from roslaunch.substitution_args import resolve_args
import rospkg
import yaml


def main():
    root = Path(sys.argv[1]).resolve()
    dataset, needs_nn, tracker, selector = sys.argv[2:]
    packages = ['ft_detector', 'ft_bringup', 'ft_detection', 'ft_msgs']
    packages += (['ft_tracker'] if tracker == '1' else []) + (['ft_selector'] if selector == '1' else [])
    rospack = rospkg.RosPack()
    for name in packages:
        actual = Path(rospack.get_path(name)).resolve()
        expected = (root / 'src' / name).resolve()
        if actual != expected or root not in actual.parents:
            raise ValueError('ROS package resolves outside the selected workspace: ' + name)
    config = root / 'src/ft_bringup/config'
    profile = config / 'datasets' / (dataset + '.yaml')
    if not profile.is_file():
        raise ValueError('Dataset profile is missing: ' + str(profile))
    enabled = dict(detector=True, tracker=tracker == '1', selector=selector == '1')
    for name in enabled:
        if enabled[name] and not (root / 'src/ft_bringup/launch' / (name + '.launch')).is_file():
            raise ValueError('Required launch interface is missing: ' + name)
    model = yaml.safe_load((config / 'model.yaml').read_text())
    overrides = yaml.safe_load(profile.read_text())
    if needs_nn == '1':
        model_path = overrides.get('nn', {}).get('model_path', model['nn']['model_path'])
        if not Path(resolve_args(model_path)).is_file():
            raise ValueError('NN model is missing: ' + resolve_args(model_path))
    executables = {}
    for name in packages:
        if name not in ('ft_detector', 'ft_tracker', 'ft_selector'):
            continue
        found = roslib.packages.find_node(name, name + '_node', rospack=rospack) or []
        if not found:
            raise ValueError('Node is not built: ' + name)
        executable = Path(found[0]).resolve()
        if root not in executable.parents:
            raise ValueError('Node resolves outside the selected workspace: ' + str(executable))
        executables[name] = str(executable)
    signatures = {cls._type: cls._md5sum for cls in (Detection, DetectionFrame, Track, Target)}
    prediction_debug = (root / 'src/ft_msgs/msg/PredictionDebug.msg').is_file()
    print(json.dumps(dict(executables=executables, signatures=signatures, prediction_debug=prediction_debug)))


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
