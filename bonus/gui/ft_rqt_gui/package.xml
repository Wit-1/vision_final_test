<?xml version="1.0"?>
<package format="2">
  <name>ft_rqt_gui</name>
  <version>0.1.0</version>
  <description>rqt control panel for the vision final test.</description>
  <maintainer email="268838183+Wit-1@users.noreply.github.com">Wit</maintainer>
  <license>BSD-3-Clause</license>
